{
  "manifest_version": 3,
  "name": "Keyboard Layout Detector",
  "version": "4.0",
  "description": "Fix Arabic/English keyboard layout mistakes",
  "content_security_policy": {
    "extension_pages": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src 'none';"
  },
  "permissions": [
    "storage"
  ],
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "all_frames": true,
      "js": [
        "fa-layout.js",
        "content.js"
      ],
      "css": [
        "styles.css"
      ]
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Keyboard Layout Detector"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "dict-en.json",
        "dict-ar.json"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}